rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function canEdit() {
      return isSignedIn() && userRole() in ['admin', 'approved'];
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function canManageCategories() {
      return isAdmin()
        || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.manageCategories == true);
    }

    // Shared by both the restaurant doc's own read rule and its photos subdoc's read rule
    // below, so the two can never drift out of sync with each other.
    function isVisibleToViewer(data) {
      return data.visibility == 'public'
        || (isSignedIn() && data.visibility == 'private' && (
             data.addedByUid == request.auth.uid ||
             request.auth.uid in data.visibleToUids ||
             isAdmin()
           ));
    }

    // Public restaurants are visible to anyone, including signed-out visitors.
    // Private restaurants are only visible to the person who added them, anyone
    // on the restaurant's own visibleToUids share list, or an admin.
    // Only admins and accounts approved by an admin can add/edit/delete.
    //
    // Every clause here is written so a matching client-side query (see
    // getAllRestaurants in db.ts) provably satisfies it — Firestore rejects
    // "list" queries outright if it can't verify that from the query's own
    // where-clauses, so an unconstrained allow-read here would break listing.
    match /restaurants/{restaurantId} {
      allow read: if isVisibleToViewer(resource.data);
      allow create, update, delete: if canEdit();

      // Snapshot recorded automatically before every edit, so past versions can
      // be reviewed and reverted to. Never edited/deleted directly by clients.
      match /history/{historyId} {
        allow read, create: if canEdit();
        allow update, delete: if false;
      }

      // Photo bytes (exteriorPhoto/dishPhoto as Base64 data URIs), kept out of the
      // main doc so the list view's queries don't have to transfer them for every
      // restaurant on every load. Only ever fetched one restaurant at a time via a
      // direct get() (see fetchRestaurantPhotos in db.ts) — never listed in bulk —
      // so the get() call below doesn't run into the list-query-provability issue
      // that shapes the rest of this file.
      match /photos/{photoId} {
        allow read: if isVisibleToViewer(get(/databases/$(database)/documents/restaurants/$(restaurantId)).data);
        allow write: if canEdit();
      }
    }

    // Shared app settings (area/cuisine categories only — per-user display
    // settings like default map center/filters live in browser localStorage,
    // not here, so they work without signing in).
    match /settings/{settingId} {
      allow read: if true;
      allow write: if canManageCategories();
    }

    // User profiles / roles. Contains email addresses, so reads are deliberately
    // narrower than "any signed-in user": you can always read your own profile (needed
    // right after signup, before you're approved, to show your pending status), but
    // reading anyone else's — or listing the whole collection — is admin-only. Approved
    // (non-admin) editors never see other users' emails/roles this way; the admin-managed
    // "非公開グループ" member pickers (settings/app.visibilityGroups) instead read the
    // email-free `usernames` collection.
    // A new signup may only create its own doc with role "pending" — nobody can
    // self-promote to admin/approved. Only an admin can change someone's role afterwards.
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'pending';
      allow update: if isAdmin();
      // Anyone can delete their own profile (account withdrawal); an admin can
      // delete anyone's.
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // Display-name uniqueness index — doc id is the name itself, holding only the
    // owning uid (no email/role). Kept separate from `users` so checking/claiming a
    // name during signup doesn't require the broader users-collection read access.
    // "create" is only reachable when no doc exists yet at that path, so this also
    // gives atomic first-writer-wins semantics for free.
    match /usernames/{name} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      // Freed up on account withdrawal so the name can be reclaimed by someone else.
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
